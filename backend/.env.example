# ============================================================
# CBT Mock AI — Environment Variables
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# ── Flask ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here
JWT_EXPIRY_HOURS=24

# ── Database (local PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cbt_mock
# Supabase:  postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Render:    set automatically by render.yaml

# ── AI Provider ───────────────────────────────────────────────
# Choose one: groq (default/free) | gemini (free) | openai (paid)
AI_PROVIDER=groq

# Groq — FREE. Fast. Get key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# Gemini — FREE tier. Get key at: https://aistudio.google.com
# Uncomment and set AI_PROVIDER=gemini to use:
# GEMINI_API_KEY=AIza_your_gemini_key_here

# OpenAI — Paid. Get key at: https://platform.openai.com
# Uncomment and set AI_PROVIDER=openai to use:
# OPENAI_API_KEY=sk-your_openai_key_here

# ── Admin credentials ─────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── CORS ──────────────────────────────────────────────────────
# Development: * | Production: https://your-app.vercel.app
CORS_ORIGINS=*

# ── Flask environment ─────────────────────────────────────────
FLASK_ENV=development
PORT=5000
